generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id              String          @id @default(uuid())
  nama            String
  email           String          @unique
  passwordHash    String          @map("password_hash")
  role            Role
  isActive        Boolean         @default(true) @map("is_active")
  createdAt       DateTime        @default(now()) @map("created_at")
  updatedAt       DateTime        @updatedAt @map("updated_at")
  auditLogs       AuditLog[]
  galleryItems    Gallery[]
  programs        Program[]
  inputRecords    SpeciesRecord[] @relation("InputBy")
  verifiedRecords SpeciesRecord[] @relation("VerifiedBy")

  @@map("users")
}

model Species {
  id                 String             @id @default(uuid())
  namaLokal          String             @map("nama_lokal")
  namaIlmiah         String             @map("nama_ilmiah")
  namaInggris        String?            @map("nama_inggris")
  jenis              JenisSpesies

  // Taksonomi Biologi Ilmiah
  kingdom            String?            @default("Animalia/Plantae")
  filum              String?
  kelas              String?
  ordo               String?
  famili             String?
  genus              String?

  // Status Konservasi & Regulasi Resmi
  statusIucn         StatusIucn         @default(LC) @map("status_iucn")
  statusPerlindungan StatusPerlindungan @default(TIDAK_DILINDUNGI) @map("status_perlindungan")
  statusCites        StatusCites        @default(NON_APPENDIX) @map("status_cites")
  statusKeberadaan   StatusKeberadaan   @default(NATIVE) @map("status_keberadaan")

  // Informasi Ekologi & Media
  deskripsi          String?            @db.Text
  habitat            String?
  fotoUrl            String?            @map("foto_url")

  createdAt          DateTime           @default(now()) @map("created_at")
  updatedAt          DateTime           @default(now()) @updatedAt @map("updated_at")

  programData        ProgramSpeciesData[]
  records            SpeciesRecord[]

  @@map("species")
}

model MonitoringPeriod {
  id          String               @id @default(uuid())
  tahun       Int
  semester    String
  label       String?
  programData ProgramSpeciesData[]
  records     SpeciesRecord[]

  @@unique([tahun, semester])
  @@map("monitoring_periods")
}

model SpeciesRecord {
  id             String             @id @default(uuid())
  speciesId      String             @map("species_id")
  periodId       String             @map("period_id")
  jumlahIndividu Int                @map("jumlah_individu")
  status         RecordStatus       @default(draft)
  catatanRevisi  String?            @map("catatan_revisi")
  inputBy        String             @map("input_by")
  verifiedBy     String?            @map("verified_by")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  index          BiodiversityIndex?
  inputter       User               @relation("InputBy", fields: [inputBy], references: [id])
  period         MonitoringPeriod   @relation(fields: [periodId], references: [id])
  species        Species            @relation(fields: [speciesId], references: [id])
  verifier       User?              @relation("VerifiedBy", fields: [verifiedBy], references: [id])

  @@map("species_records")
}

model BiodiversityIndex {
  id              String        @id @default(uuid())
  speciesRecordId String        @unique @map("species_record_id")
  pi              Float
  lnPi            Float         @map("ln_pi")
  hValue          Float         @map("h_value")
  calculatedAt    DateTime      @default(now()) @map("calculated_at")

  record          SpeciesRecord @relation(fields: [speciesRecordId], references: [id], onDelete: Cascade)

  @@map("biodiversity_index")
}

model Program {
  id             String                  @id @default(uuid())
  nama           String
  deskripsi      String
  anggaran       Float
  status         ProgramStatus           @default(draft)
  createdBy      String                  @map("created_by")
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  photos         ProgramPhoto[]
  speciesData    ProgramSpeciesData[]
  supportingData ProgramSupportingData[]
  creator        User                    @relation(fields: [createdBy], references: [id])

  @@map("programs")
}

model ProgramSpeciesData {
  id             String           @id @default(uuid())
  programId      String           @map("program_id")
  speciesId      String           @map("species_id")
  periodId       String           @map("period_id")
  jumlahIndividu Int              @map("jumlah_individu")
  period         MonitoringPeriod @relation(fields: [periodId], references: [id])
  program        Program          @relation(fields: [programId], references: [id], onDelete: Cascade)
  species        Species          @relation(fields: [speciesId], references: [id])

  @@unique([programId, speciesId, periodId])
  @@map("program_species_data")
}

model ProgramSupportingData {
  id          String   @id @default(uuid())
  programId   String   @map("program_id")
  namaDaerah  String   @map("nama_daerah")
  jumlah2022  Int      @default(0) @map("jumlah_2022")
  jumlah2023  Int      @default(0) @map("jumlah_2023")
  jumlah2024  Int      @default(0) @map("jumlah_2024")
  jumlah2025  Int      @default(0) @map("jumlah_2025")
  jumlah2026  Int      @default(0) @map("jumlah_2026")
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_supporting_data")
}

model ProgramPhoto {
  id        String  @id @default(uuid())
  programId String  @map("program_id")
  fileUrl   String  @map("file_url")
  caption   String?
  program   Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@map("program_photos")
}

model GalleryCategory {
  id           String    @id @default(uuid())
  namaKategori String    @map("nama_kategori")
  items        Gallery[]

  @@map("gallery_categories")
}

model Gallery {
  id         String          @id @default(uuid())
  judul      String
  fileUrl    String          @map("file_url")
  categoryId String          @map("category_id")
  uploadedBy String          @map("uploaded_by")
  createdAt  DateTime        @default(now()) @map("created_at")
  category   GalleryCategory @relation(fields: [categoryId], references: [id])
  uploader   User            @relation(fields: [uploadedBy], references: [id])

  @@map("gallery")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  aksi         String
  tabelTerkait String   @map("tabel_terkait")
  dataSebelum  Json?    @map("data_sebelum")
  dataSesudah  Json?    @map("data_sesudah")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

enum Role {
  petugas_lapangan
  admin
  super_admin
}

enum JenisSpesies {
  flora
  fauna
}

enum StatusIucn {
  CR // Critically Endangered (Kritis)
  EN // Endangered (Genting)
  VU // Vulnerable (Rentan)
  NT // Near Threatened (Hampir Terancam)
  LC // Least Concern (Risiko Rendah)
  DD // Data Deficient (Kurang Data)
  NE // Not Evaluated (Belum Dievaluasi)
}

enum StatusPerlindungan {
  DILINDUNGI        // Sesuai Permen LHK P.106/2018
  TIDAK_DILINDUNGI
}

enum StatusCites {
  APPENDIX_I
  APPENDIX_II
  APPENDIX_III
  NON_APPENDIX
}

enum StatusKeberadaan {
  NATIVE     // Asli
  ENDEMIC    // Endemik Indonesia/Lokal
  INTRODUCED // Introduksi
  INVASIVE   // Invasif
}

enum RecordStatus {
  draft
  pending
  published
  rejected
}

enum ProgramStatus {
  draft
  published
}